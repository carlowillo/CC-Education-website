{
  "name": "education-reach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --use-env-proxy --import tsx server/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node scripts/create-preview.mjs && playwright test",
    "preview:download": "npm run build && node scripts/create-preview.mjs",
    "locations:resolve": "node --env-file-if-exists=.env --use-env-proxy --import tsx scripts/resolve-locations.ts",
    "routing:validate": "node --env-file-if-exists=.env --use-env-proxy --import tsx scripts/validate-routing.ts",
    "routing:cross-check": "node --env-file-if-exists=.env --use-env-proxy --import tsx scripts/cross-check-routing.ts",
    "routing:expand": "node --env-file-if-exists=.env --use-env-proxy --import tsx scripts/expand-coverage.ts",
    "routing:combine": "node --import tsx scripts/combine-open-coverage.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.15",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
