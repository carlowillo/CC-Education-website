# Optional: map browsing works without these. Never commit actual credentials.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
# Password-protected hosting: see VERCEL-DEPLOYMENT.md or PREVIEW-AND-PUBLISH.md.
HOST=127.0.0.1
PORT=3000
# Required for external hosting (16+ characters). Local use can leave this unset.
# Vercel always requires this, regardless of HOST. Set it in Vercel settings.
ADMIN_USERNAME=viewer
ADMIN_PASSWORD=
