# Optional: map browsing works without these. Never commit actual credentials.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
# Local-only by default. Use an authenticated gateway before exposing externally.
HOST=127.0.0.1
PORT=3000
# Required for external hosting (16+ characters). Local use can leave this unset.
ADMIN_USERNAME=viewer
ADMIN_PASSWORD=
